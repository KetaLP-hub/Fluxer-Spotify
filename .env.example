# Kopiere diese Datei nach ".env" (ohne .example) und trage deine Werte ein.
# Copy this file to ".env" (without .example) and fill in your values.

# Spotify Client ID (developer.spotify.com/dashboard -> deine App -> Settings)
SPOTIFY_CLIENT_ID=deine_spotify_client_id

# Fluxer Account-Token fuer den Profil-Status (wie ein Passwort behandeln!)
FLUXER_TOKEN=dein_fluxer_token

# Optional: Webhook-URL fuer eine Karte im Channel (leer lassen, wenn nicht gewuenscht)
FLUXER_WEBHOOK=

# Optional: nur aendern, wenn du eine eigene Fluxer-Instanz nutzt
# FLUXER_API=https://api.fluxer.app/v1
