# Kopiere diese Datei nach ".env" (ohne .example) und trage deine Werte ein.
# Copy this file to ".env" (without .example) and fill in your values.
# Normalerweise nicht noetig: das Programm fragt die Client ID beim ersten Start selbst ab. / Usually not needed: the app asks for the Client ID on first start.
# Prioritaet / precedence: Kommandozeilen-Flags > Umgebungsvariablen > .env

# Spotify Client ID (developer.spotify.com/dashboard -> deine App -> Settings). Pflicht / required.
# SPOTIFY_CLIENT_ID=

# Den Fluxer-Token brauchst du NICHT mehr einzutragen: "python spotify_status.py fluxer-login" erledigt das.
# You no longer need to enter a Fluxer token: "python spotify_status.py fluxer-login" does it.
# Nur setzen, wenn du einen Token von Hand verwenden willst (hat dann Vorrang vor dem gespeicherten):
# FLUXER_TOKEN=

# Optional: Webhook-URL fuer eine Karte im Channel (leer lassen, wenn nicht gewuenscht)
FLUXER_WEBHOOK=

# Optional: Text des Status. Platzhalter: {title} {artist} {album}
# STATUS_TEMPLATE=🎵 {title} – {artist}

# Optional: Verhalten bei Pause: clear (Status loeschen, Standard), keep (stehen lassen) oder stats (nur top_artist/listening_today rotieren)
# ON_PAUSE=clear

# Optional: wenn gar nichts laeuft: clear (Status loeschen, Standard) oder lines (Zeilen ohne Titel weiter rotieren, z. B. GitHub)
# When nothing plays at all: clear (default) or lines (keep rotating the lines that need no track, e.g. GitHub)
# ON_IDLE=clear

# Optional: rotierende Statuszeilen (Namen: now, playlist, top_artist, listening_today, gh_push, gh_commits, gh_prs, gh_reviews,
# gh_issues, gh_streak, gh_stars, gh_followers; oder eigene Texte mit {title} {artist} {album} {playlist} {top_artist} {hours} {minutes}
# {gh_repo} {gh_ago} {gh_commits} {gh_prs} {gh_reviews} {gh_issues} {gh_streak} {gh_stars} {gh_followers}, dann mit | trennen).
# Sekunden pro Zeile: mindestens 15. GitHub verbinden: github-login
# STATUS_LINES=now,playlist,top_artist,listening_today
# ROTATE_SECONDS=30
# NO_ROTATE=1

# Optional: Sprache aller Meldungen: auto (Standard, folgt dem Betriebssystem), de oder en. / Language of all messages: auto (default, follows the OS), de or en.
# LANGUAGE=auto

# Optional: Abfrage-Intervall in Sekunden (mindestens 2)
# POLL_INTERVAL=5

# Optional: Der Status loescht sich bei Fluxer von selbst nach so vielen Sekunden, wenn das Programm ihn nicht erneuert (z. B. PC aus). 0 = aus, mindestens 120.
# The status clears itself at Fluxer after this many seconds unless the program renews it (e.g. PC switched off). 0 = off, minimum 120.
# STATUS_TTL=600

# Optional: nur aendern, wenn du eine eigene Fluxer-Instanz nutzt (muss https:// sein)
# FLUXER_API=https://api.fluxer.app/v1
